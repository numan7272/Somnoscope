      },
      "description": "Raumklima (co2/temperature/humidity). Hinweis: Der aktuelle InfluxWriter schreibt nur Vitalmetriken nach InfluxDB — Klima-Mittelwerte landen im SleepReport (SQLite). Dieses Panel bleibt leer, bis Klimadaten in den Bucket geschrieben werden; die Query greift dann automatisch.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": 600000,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "noValue": "Keine Klimadaten in InfluxDB (siehe Panel-Beschreibung)",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*co2.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ppm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*temperature.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*humidity.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "humidity"
              }
            ]
          }
        ]
      },
